#version 460 core
layout(local_size_x = 16, local_size_y = 16) in;
layout(rgba32f, binding = 0) uniform readonly image2DArray heightDxzInput;
layout(rgba32f, binding = 1) uniform readonly image2DArray derivXXZZInput;
layout(rgba32f, binding = 2) uniform readonly image2DArray dxdyInput;
layout(rgba32f, binding = 3) uniform readonly image2DArray dispXYInput;
layout(rgba32f, binding = 4) uniform readonly image2DArray foamInput;
layout(rgba32f, binding = 5) uniform writeonly image2DArray normalOutput;
layout(rgba32f, binding = 6) uniform writeonly image2DArray displacementOutput;
layout(rgba32f, binding = 7) uniform writeonly image2DArray foamOutput;
const int MAX_SPECTRUM_COUNT = 8;
uniform int numSpectrums;
uniform float[MAX_SPECTRUM_COUNT] foamBiases;
uniform float choppiness;
uniform float foamDecayFactor; 
uniform int resolution;
void main(){
	ivec2 id = ivec2(gl_GlobalInvocationID.xy);
	if (id.x >= resolution || id.y >= resolution) return;
	for(int i=0;i<numSpectrums;i++){
		ivec3 inputId = ivec3(id,i);
		vec4 heightDxz = imageLoad(heightDxzInput, inputId);
		vec4 DerivXXZZ = imageLoad(derivXXZZInput, inputId);
		vec4 dxdy = imageLoad(dxdyInput, inputId);
		vec4 dispXY = imageLoad(dispXYInput, inputId);
		float dDx_dx = DerivXXZZ.r * choppiness;
		float dDz_dz = DerivXXZZ.b * choppiness;
		float dDx_dz = heightDxz.b * choppiness;
		float dDz_dx = dDx_dz;
		float J = (1.0 + dDx_dx) * (1.0 + dDz_dz) - (dDx_dz * dDz_dx);
		J-=0.55+foamBiases[i];

		float foamGeneration = smoothstep(0.4, 0.0, J);
		float oldFoam = imageLoad(foamInput, inputId).r;
		float newFoam = oldFoam+foamGeneration;
		newFoam *= exp(-foamDecayFactor);
		newFoam = clamp(newFoam, 0.0, 1.0);
		imageStore(foamOutput, inputId, vec4(newFoam, 0.0, 0.0, 0.0));
		vec3 normal = normalize(vec3(-dxdy.r, 1.0, -dxdy.b));
		imageStore(normalOutput, inputId, vec4(normal, 1.0));
		imageStore(displacementOutput, inputId, vec4(dispXY.r * choppiness,heightDxz.r,dispXY.b*choppiness, 0.0));
	}



}