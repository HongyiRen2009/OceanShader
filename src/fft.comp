#version 460 core
layout(local_size_x = 16, local_size_y = 16) in;
layout(rg32f, binding = 0) uniform readonly image2D img_input;
layout(rg32f, binding = 1) uniform writeonly image2D img_output;
layout(rgba32f, binding = 2) uniform readonly image2D img_twiddle;
uniform int resolution;
uniform uint stage;
uniform bool horizontal;
uniform bool normalization;
uniform bool applyShift;
const float PI = 3.1415926535897932384626433832795;
vec2 ComplexMult(vec2 a, vec2 b)
{
	return vec2(a.r * b.r - a.g * b.g, a.r * b.g + a.g * b.r);
}
void horizontalIFFT(ivec2 id){
	vec4 data = imageLoad(img_twiddle, ivec2(stage,id.x));
	ivec2 inputIndex = ivec2(data.ba);
	vec2 firstVal = imageLoad(img_input, ivec2(inputIndex.x, id.y)).rg;
	vec2 secondVal = imageLoad(img_input, ivec2(inputIndex.y, id.y)).rg;
	vec2 res = firstVal + ComplexMult(vec2(data.r, -data.g), secondVal);
	if(normalization){
		res/= stage;
	}
	if(applyShift){
		res *= (1.0 - 2.0 * ((id.x + id.y) % 2));

	}

	imageStore(img_output,id.xy,vec4(res,0.0,0.0));
}
void verticalIFFT(ivec2 id){
	vec4 data = imageLoad(img_twiddle, ivec2(stage,id.y));
	ivec2 inputIndex = ivec2(data.ba);
	vec2 firstVal = imageLoad(img_input, ivec2(id.x,inputIndex.x)).rg;
	vec2 secondVal = imageLoad(img_input, ivec2(id.x,inputIndex.y)).rg;
	vec2 res = firstVal + ComplexMult(vec2(data.r, -data.g), secondVal);
	if(normalization){
		res/= stage;
	}
	if(applyShift){
		res *= (1.0 - 2.0 * ((id.x + id.y) % 2));

	}

	imageStore(img_output,id.xy,vec4(res,0.0,0.0));
}

void main()
{
	ivec2 id = ivec2(gl_GlobalInvocationID.xy);
	if(horizontal)
		horizontalIFFT(id);
	else
		verticalIFFT(id);
}